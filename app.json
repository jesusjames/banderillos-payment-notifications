{
  "expo": {
    "name": "Banderillos Pagos",
    "slug": "banderillos-payment-notifications",
    "scheme": "banderillospagos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#FFF8E7",
    "platforms": ["android"],
    "android": {
      "package": "com.banderillos.paymentnotifications",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFF8E7",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font",
      "./plugins/withReleaseSigning",
      "./plugins/withJdk25Support",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8E7"
        }
      ]
    ]
  }
}
